{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fa81c2d3-6d36-4501-a33e-7e320fd60430","database_name": "nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dcdddcc991a243c5864484c70d45388c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
